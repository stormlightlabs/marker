---
import SiteFooter from '../components/SiteFooter.astro';
import SiteHeader from '../components/SiteHeader.astro';
import '@fontsource-variable/lora/index.css';
import '@fontsource-variable/sora/index.css';
import '../styles/site.css';

type Props = { title: string; description: string };

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
  </head>
  <body>
    <SiteHeader />
    <main>
      <slot />
    </main>
    <SiteFooter />
    <script>
      import { annotate, annotationGroup } from 'rough-notation';
      import type { RoughAnnotationType } from 'rough-notation/lib/model';

      const roughDefaults = { animate: true, animationDuration: 900, iterations: 2, padding: 5, strokeWidth: 2 };

      const initRoughAnnotations = () => {
        const elements = Array.from(document.querySelectorAll('[data-rough]')).filter(
          (element) => element instanceof HTMLElement && element.dataset.roughReady !== 'true',
        );
        if (elements.length === 0) return;

        const annotations = (elements as Array<HTMLElement>).map((element) => {
          element.dataset.roughReady = 'true';
          return annotate(element, {
            ...roughDefaults,
            type: (element.dataset.rough as RoughAnnotationType) || 'underline',
            color: element.dataset.roughColor ?? '#2d6cdf',
            padding: Number(element.dataset.roughPadding ?? roughDefaults.padding),
            strokeWidth: Number(element.dataset.roughStroke ?? roughDefaults.strokeWidth),
            iterations: Number(element.dataset.roughIterations ?? roughDefaults.iterations),
            animationDuration: Number(element.dataset.roughDuration ?? roughDefaults.animationDuration),
            multiline: element.dataset.roughMultiline === 'true',
          });
        });

        window.setTimeout(() => annotationGroup(annotations).show(), 250);
      };

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initRoughAnnotations, { once: true });
      } else {
        initRoughAnnotations();
      }
      document.addEventListener('astro:page-load', initRoughAnnotations);
    </script>
  </body>
</html>
