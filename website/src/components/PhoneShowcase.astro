---
// FIXME: the bezel is off
// TODO: either rebuild the UI or use a screenshot
---

<section class="phone-showcase">
  <div class="phone-showcase__inner">
    <div class="phone-showcase__caption phone-showcase__caption--left">
      <p>
        Marker turns each page into a<br />
        <strong data-rough="underline" data-rough-color="#2d6cdf" data-rough-padding="2">working document.</strong><br />
        Highlights persist across sessions.
      </p>
    </div>

    <div class="phone-frame" aria-label="Marker app on iPhone">
      <div class="phone-frame__shell">
        <div class="phone-frame__screen">
          <div class="phone-frame__status" aria-hidden="true">
            <span>9:41</span>
            <span class="phone-frame__status-icons">
              <svg width="16" height="12" viewBox="0 0 16 12" fill="none">
                <rect x="0" y="6" width="3" height="6" rx="1" fill="white" opacity="0.4"></rect>
                <rect x="4.5" y="4" width="3" height="8" rx="1" fill="white" opacity="0.6"></rect>
                <rect x="9" y="2" width="3" height="10" rx="1" fill="white" opacity="0.8"></rect>
                <rect x="13" y="0" width="3" height="12" rx="1" fill="white"></rect>
              </svg>
              <svg width="15" height="11" viewBox="0 0 15 11" fill="none">
                <path d="M7.5 9.5 L7.5 9.5" stroke="white" stroke-width="2" stroke-linecap="round"></path>
                <path d="M4.5 7 Q7.5 4.5 10.5 7" stroke="white" stroke-width="1.5" stroke-linecap="round" fill="none">
                </path>
                <path
                  d="M1.5 4 Q7.5 -0.5 13.5 4"
                  stroke="white"
                  stroke-width="1.5"
                  stroke-linecap="round"
                  fill="none"
                  opacity="0.5"></path>
              </svg>
              <svg width="22" height="11" viewBox="0 0 22 11" fill="none">
                <rect x="0.5" y="0.5" width="18" height="10" rx="3" stroke="white" stroke-opacity="0.35"></rect>
                <rect x="1.5" y="1.5" width="14" height="8" rx="2" fill="white"></rect>
                <path d="M19.5 3.5 L19.5 7.5 Q21 7 21 5.5 Q21 4 19.5 3.5 Z" fill="white" opacity="0.4"></path>
              </svg>
            </span>
          </div>

          <div class="phone-frame__island" aria-hidden="true"></div>

          <div class="phone-frame__content">
            <div class="phone-article">
              <div>The Feynman Technique</div>
              <p>
                Choose a concept. Explain it as if teaching a child.
                <span>Identify gaps in your explanation.</span>
                Return to the source material.
              </p>
              <p><mark>Review and simplify.</mark></p>
            </div>

            <div class="annotation-card" data-rough="circle" data-rough-color="#2477d4" data-rough-padding="8">
              <div class="annotation-card__level" aria-label="Note">N</div>
              <div class="annotation-card__word">Feynman</div>
              <div class="annotation-card__meaning">Nobel physicist and legendary teacher</div>
              <div class="annotation-card__source">Physics Today, 1988</div>
            </div>

            <div class="phone-toolbar" aria-label="Annotation tools">
              <button type="button" aria-label="Highlight">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                  <rect x="3" y="8" width="14" height="5" rx="2" fill="#FFD85A" opacity="0.9"></rect>
                  <path d="M5 15 H15" stroke="rgba(255,255,255,0.35)" stroke-width="1.5" stroke-linecap="round"></path>
                </svg>
                <span>Highlight</span>
              </button>
              <button type="button" aria-label="Note">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                  <rect
                    x="3"
                    y="3"
                    width="14"
                    height="11"
                    rx="2.5"
                    stroke="rgba(255,255,255,0.6)"
                    stroke-width="1.5"
                    fill="none"></rect>
                  <path d="M6 7 H14 M6 10 H11" stroke="rgba(255,255,255,0.6)" stroke-width="1.5" stroke-linecap="round"
                  ></path>
                  <circle cx="15" cy="15" r="4" fill="#FFD85A"></circle>
                  <path d="M15 13 V15 H17" stroke="#111" stroke-width="1.3" stroke-linecap="round"></path>
                </svg>
                <span>Note</span>
              </button>
              <button type="button" aria-label="Underline">
                <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                  <path
                    d="M6 5 V11 Q6 14.5 10 14.5 Q14 14.5 14 11 V5"
                    stroke="rgba(255,255,255,0.6)"
                    stroke-width="1.5"
                    stroke-linecap="round"
                    fill="none"></path>
                  <path d="M4 17 H16" stroke="rgba(255,255,255,0.6)" stroke-width="1.5" stroke-linecap="round"></path>
                </svg>
                <span>Underline</span>
              </button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="phone-showcase__caption phone-showcase__caption--right">
      <div>W3C</div>
      <p>
        Annotation spec.<br />
        Anchors survive page updates.
      </p>
    </div>
  </div>

</section>

<style>
  .phone-article {
    padding: 10px 10px 0;
    color: rgba(255, 255, 255, 0.7);
    font-size: 11.5px;
    line-height: 1.55;

    div {
      margin-bottom: 6px;
      color: white;
      font-size: 13px;
      font-weight: 800;
    }

    p {
      margin-bottom: 8px;
    }

    span {
      padding: 0 2px;
      border-radius: 2px;
      background: var(--highlight);
      color: var(--ink);
      font-weight: 650;
    }

    mark {
      padding-bottom: 1px;
      border-bottom: 1.5px solid rgba(255, 255, 255, 0.5);
      background: transparent;
      color: inherit;
    }
  }

  .phone-showcase {
    position: relative;
    z-index: 1;
    overflow: visible;
    border-radius: var(--radius-lg);
    background: var(--surface-raised);

    .phone-showcase__inner {
      display: grid;
      grid-template-columns: minmax(12rem, 1fr) auto minmax(12rem, 1fr);
      align-items: center;
      gap: 2rem;
    }

    .phone-showcase__caption {
      color: var(--ink-soft);
      font-size: var(--size-lg);
      line-height: var(--line-loose);

      div {
        margin-bottom: 0.25rem;
        color: var(--ink);
        font-size: var(--size-2xl);
        font-weight: 760;
        line-height: var(--line-tight);
      }

      p:last-child {
        color: var(--ink-muted);
        font-size: var(--size-sm);
        line-height: var(--line-base);
      }
    }

    .phone-showcase__caption--left {
      padding-right: 2rem;
      text-align: right;
    }

    .phone-showcase__caption--right {
      padding-left: 2rem;
    }

  }

  .phone-frame {
    width: 260px;
    flex-shrink: 0;

    .phone-frame__shell {
      padding: 14px;
      border-radius: 44px;
      background: #f0f0ef;
      box-shadow:
        0 0 0 1px rgba(0, 0, 0, 0.08),
        0 8px 24px rgba(0, 0, 0, 0.1),
        0 32px 64px rgba(0, 0, 0, 0.08),
        inset 0 0 0 1px rgba(255, 255, 255, 0.6);
    }

    .phone-frame__screen {
      position: relative;
      overflow: hidden;
      aspect-ratio: 9 / 19.5;
      border-radius: 34px;
      background: #1c1c1e;
    }

    .phone-frame__status {
      position: absolute;
      top: 16px;
      right: 0;
      left: 0;
      z-index: 3;
      padding: 0 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      color: rgba(255, 255, 255, 0.9);
      font-size: 11px;
      font-weight: 700;
    }

    .phone-frame__status-icons {
      display: flex;
      align-items: center;
      gap: 4px;
    }

    .phone-frame__island {
      position: absolute;
      top: 26px;
      left: 50%;
      z-index: 2;
      width: 80px;
      height: 26px;
      border-radius: 20px;
      background: #000000;
      transform: translateX(-50%);
    }

    .phone-frame__content {
      position: absolute;
      top: 60px;
      right: 14px;
      bottom: 14px;
      left: 14px;
      z-index: 1;
    }
  }

  .annotation-card {
    margin-top: 10px;
    padding: 14px 16px;
    border-radius: var(--radius-lg);
    background: #1c1c1e;
    color: white;
    font-size: 14px;
    line-height: 1.4;

    .annotation-card__level {
      width: 22px;
      height: 22px;
      margin-bottom: 8px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 50%;
      background: var(--green);
      color: var(--ink);
      font-size: 10px;
      font-weight: 800;
    }

    .annotation-card__word {
      margin-bottom: 2px;
      font-size: 24px;
      font-weight: 760;
    }

    .annotation-card__meaning {
      color: rgba(255, 255, 255, 0.6);
      font-size: 13px;
    }

    .annotation-card__source {
      margin-top: 4px;
      color: rgba(255, 255, 255, 0.38);
      font-size: 11px;
      font-style: italic;
    }
  }

  .phone-toolbar {
    position: absolute;
    right: 0;
    bottom: 0;
    left: 0;
    padding: 10px 12px;
    display: flex;
    align-items: center;
    justify-content: space-around;
    border-radius: 0 0 20px 20px;
    background: rgba(28, 28, 30, 0.92);
    backdrop-filter: blur(12px);

    button {
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 3px;
    }

    span {
      color: rgba(255, 255, 255, 0.48);
      font-size: 8px;
    }
  }
</style>
