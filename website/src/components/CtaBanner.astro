---

---

<section class="cta-banner">
  <svg class="sketch cta-banner__highlight" width="560" height="80" viewBox="0 0 560 80" fill="none" aria-hidden="true">
    <path
      d="M 40 55 C 120 42, 260 38, 400 44 C 470 47, 520 52, 530 58 C 520 64, 460 68, 400 66 C 260 62, 120 66, 40 60 Z"
      fill="#FFD85A"
      opacity="0.35"></path>
  </svg>

  <p class="eyebrow">Coming soon</p>
  <h2>
    Read <span class="cta-banner__marked">more</span>.<br />
    <span class="cta-banner__underlined">Remember more.</span>
  </h2>
  <p>Launching on the App Store. Your data never leaves your device.</p>
  <span class="button button--primary button--large button--disabled" aria-label="Not yet available">
    Coming Soon
    <span class="button__badge button__badge--ios">iOS</span>
    <span class="button__badge button__badge--android">Android</span>
  </span>
</section>

<style>
  .cta-banner {
    --inner-width: 700px;
    position: relative;
    overflow: visible;
    padding-top: 6rem;
    padding-bottom: 6rem;
    text-align: center;

    .cta-banner__highlight {
      position: absolute;
      top: 50%;
      left: 50%;
      z-index: 0;
      transform: translate(-50%, -56%);
    }

    .eyebrow,
    h2,
    p,
    .button {
      position: relative;
      z-index: 1;
    }

    .eyebrow {
      margin-bottom: 0.75rem;
    }

    h2 {
      isolation: isolate;
      margin-bottom: 1rem;
      font-family: "Lora Variable", ui-serif, Georgia, serif;
      font-size: clamp(var(--size-3xl), 5vw, var(--size-6xl));
      font-weight: 760;
      line-height: var(--line-tight);
      letter-spacing: 0;
    }

    .cta-banner__marked {
      position: relative;
      display: inline-block;

      &::after {
        content: "";
        position: absolute;
        right: -0.08em;
        bottom: 0.08em;
        left: -0.08em;
        z-index: -1;
        height: 0.32em;
        border-radius: 2px;
        background: var(--highlight);
        opacity: 0.7;
      }
    }

    .cta-banner__underlined {
      text-decoration: underline;
      text-decoration-color: var(--highlight);
      text-decoration-thickness: 0.12em;
      text-underline-offset: 0.13em;
    }

    p {
      max-width: 380px;
      margin: 0 auto 2.5rem;
      color: var(--ink-soft);
      font-size: var(--size-lg);
      line-height: 1.65;
    }
  }
</style>
