---

---

<section class="cta-banner">
  <p class="eyebrow" data-rough="circle" data-rough-color="#2d6cdf" data-rough-padding="7">Coming soon</p>
  <h2>
    Read <span class="cta-banner__marked" data-rough="highlight" data-rough-color="#FFD85A" data-rough-padding="3" data-rough-stroke="4">more</span>.<br />
    <span class="cta-banner__underlined" data-rough="underline" data-rough-color="#FFD85A" data-rough-padding="2">Remember more.</span>
  </h2>
  <p>Launching on the App Store. Your data never leaves your device.</p>
  <span class="button button--primary button--large button--disabled" aria-label="Not yet available">
    Coming Soon
    <span class="button__badge button__badge--ios">iOS</span>
    <span class="button__badge button__badge--android">Android</span>
  </span>
</section>

<style>
  .cta-banner {
    --inner-width: 700px;
    position: relative;
    overflow: visible;
    padding-top: 6rem;
    padding-bottom: 6rem;
    text-align: center;

    .eyebrow,
    h2,
    p,
    .button {
      position: relative;
      z-index: 1;
    }

    .eyebrow {
      margin-bottom: 0.75rem;
    }

    h2 {
      isolation: isolate;
      margin-bottom: 1rem;
      font-family: 'Lora Variable', ui-serif, Georgia, serif;
      font-size: clamp(var(--size-3xl), 5vw, var(--size-6xl));
      font-weight: 760;
      line-height: var(--line-tight);
      letter-spacing: 0;
    }

    .cta-banner__marked,
    .cta-banner__underlined {
      position: relative;
      display: inline-block;
    }

    p {
      max-width: 380px;
      margin: 0 auto 2.5rem;
      color: var(--ink-soft);
      font-size: var(--size-lg);
      line-height: 1.65;
    }
  }
</style>
